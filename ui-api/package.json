{
  "name": "ui-api",
  "version": "1.0.0",
  "private": true,
  "description": "Playwright TypeScript UI and future API discovery framework for automationexercise.com",
  "scripts": {
    "test": "playwright test",
    "test:headed": "playwright test --project=chromium --headed",
    "test:phase1": "playwright test tests/automation-exercise.phase1.spec.ts",
    "test:api": "playwright test tests/api",
    "test:smoke": "playwright test tests/api --grep @smoke",
    "test:regression": "playwright test tests/api --grep @regression",
    "test:negative": "playwright test tests/api --grep @negative",
    "test:e2e": "playwright test tests/api --grep @e2e",
    "generate:api-tests": "ts-node ./src/generation/generate-api-tests.ts",
    "record:suite": "ts-node ./src/reporting/record-suite-result.ts",
    "generate:deliverables": "ts-node ./src/reporting/generate-deliverables.ts",
    "test:api-discovered": "playwright test tests/generated/observed-api.spec.ts",
    "allure": "allure generate allure-results --clean -o allure-report",
    "report": "playwright show-report"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "@types/node": "^26.6.5",
    "allure-commandline": "^2.46.1",
    "allure-playwright": "^3.14.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3"
  }
}
